# Neon PostgreSQL connection string.
# Copy to .env.local for local development. Never commit real credentials.
# In development, use the Neon development branch, not production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Payments
# MF_PAYMENTS_MODE=dev (default): no live provider; payments wait for an
# explicit test callback and NOTHING auto-succeeds. Set to "daraja" with the
# credentials below to take real M-Pesa STK payments via Safaricom Daraja.
MF_PAYMENTS_MODE=dev
# MF_DATA_DIR=.data

# Platform admin key. Exchanged for a session cookie at /admin and accepted as
# a bearer token by the admin APIs (refunds, station approval). The /admin
# pages additionally require a signed-in "operations" account - see
# "Local admin access" in README.md. Generate one with: openssl rand -hex 32
MF_ADMIN_KEY=

# Safaricom Daraja (https://developer.safaricom.co.ke) - server-side only.
# DARAJA_ENV=sandbox
# DARAJA_CONSUMER_KEY=
# DARAJA_CONSUMER_SECRET=
# DARAJA_SHORTCODE=
# DARAJA_PASSKEY=
# DARAJA_CALLBACK_URL=https://your-domain/api/payments/callback

# Daraja reversal (refunds) - required only to confirm refunds in daraja mode.
# DARAJA_INITIATOR=
# DARAJA_SECURITY_CREDENTIAL=
# DARAJA_RESULT_URL=https://your-domain/api/payments/callback
# DARAJA_QUEUE_TIMEOUT_URL=https://your-domain/api/payments/callback
# Customer phone sign-in (OTP)
# MF_OTP_SECRET is the HMAC key used to hash one-time codes at rest. Set a
# random 32-byte hex value in every deployed environment; the built-in
# development default is not secret. Generate one with: openssl rand -hex 32
# MF_OTP_SECRET=
# MF_SMS_PROVIDER=dev|africastalking|twilio (optional; inferred from credentials)
# MF_SMS_DEV_ECHO=0            set to 0 to stop logging dev codes
# MF_SMS_WEBHOOK_URL=          generic provider: POST { to, message }
# MF_SMS_AT_USERNAME=          Africa's Talking
# MF_SMS_AT_API_KEY=
# MF_SMS_SENDER=
# MF_SMS_TWILIO_ACCOUNT_SID=   Twilio
# MF_SMS_TWILIO_AUTH_TOKEN=
# MF_SMS_TWILIO_FROM=
