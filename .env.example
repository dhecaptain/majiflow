# Neon PostgreSQL connection string.
# Copy to .env.local for local development. Never commit real credentials.
# In development, use the Neon development branch, not production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Payments
# Pay on delivery (cash or M-Pesa to the rider) is always offered. M-Pesa up
# front is offered only with a live provider in production:
# MF_PAYMENTS_MODE=dev (default without Daraja keys): no live provider; online
# payments wait for an explicit test callback and NOTHING auto-succeeds. In
# production this mode hides M-Pesa checkout entirely.
# MF_PAYMENTS_MODE=daraja with the DARAJA_* credentials takes real STK payments.
# MF_PAYMENTS_MODE=dev
# MF_PAYMENTS_CALLBACK_TOKEN=  required for Daraja: random secret, also appended
#   to DARAJA_CALLBACK_URL and DARAJA_RESULT_URL as ?token=<value>
# DARAJA_RESULT_URL=https://<site>/api/payments/reversal-result?token=<value>
# MF_DATA_DIR=.data   development/tests only: JSON files instead of Postgres
# MF_DB_POOL_MAX=5     connections per instance; use Neon's -pooler host
# CRON_SECRET=         authorizes /api/cron/retention (Vercel Cron sends it)

# Platform admin key. Exchanged for a session cookie at /admin and accepted as
# a bearer token by the admin APIs (refunds, station approval). The /admin
# pages additionally require a signed-in "operations" account - see
# "Local admin access" in README.md. Generate one with: openssl rand -hex 32
MF_ADMIN_KEY=

# Safaricom Daraja (https://developer.safaricom.co.ke) - server-side only.
# DARAJA_ENV=sandbox
# DARAJA_CONSUMER_KEY=
# DARAJA_CONSUMER_SECRET=
# DARAJA_SHORTCODE=
# DARAJA_PASSKEY=
# DARAJA_CALLBACK_URL=https://your-domain/api/payments/callback?token=<MF_PAYMENTS_CALLBACK_TOKEN>

# Daraja reversal (refunds) - required only to confirm refunds in daraja mode.
# DARAJA_INITIATOR=
# DARAJA_SECURITY_CREDENTIAL=
# DARAJA_RESULT_URL=https://your-domain/api/payments/callback
# DARAJA_QUEUE_TIMEOUT_URL=https://your-domain/api/payments/callback
# Customer phone sign-in (OTP)
# MF_OTP_SECRET is the HMAC key used to hash one-time codes at rest. Set a
# random 32-byte hex value in every deployed environment; the built-in
# development default is not secret. Generate one with: openssl rand -hex 32
# MF_OTP_SECRET=
# MF_SMS_PROVIDER=dev|africastalking|twilio (optional; inferred from credentials)
# MF_SMS_DEV_ECHO=0            set to 0 to stop logging dev codes
# MF_SMS_WEBHOOK_URL=          generic provider: POST { to, message }
# MF_SMS_AT_USERNAME=          Africa's Talking
# MF_SMS_AT_API_KEY=
# MF_SMS_SENDER=
# MF_SMS_TWILIO_ACCOUNT_SID=   Twilio
# MF_SMS_TWILIO_AUTH_TOKEN=
# MF_SMS_TWILIO_FROM=

# Site
# Absolute public URL. Read at BUILD time (canonical URLs, sitemap, share
# previews), so set it in the build environment too.
NEXT_PUBLIC_SITE_URL=https://majiflow.co.ke

# Stations
# MF_DEMO_STATIONS=1  list the sample stations (on by default in development,
#                     off in production). Never set it on the live site.

# Monitoring and customer updates
# MF_ALERT_WEBHOOK_URL=   where failures are POSTed (Slack/Teams/incident tool)
# MF_NOTIFY_WEBHOOK_URL=  optional order-status provider: POST
#                         { orderId, orderNumber, status, to, message }.
#                         Without it, status updates are texted via the SMS provider.
# MF_CONTACT_WEBHOOK_URL= where contact-form messages are POSTed (falls back to
#                         MF_ALERT_WEBHOOK_URL; without either the form opens
#                         the visitor's email app instead)
